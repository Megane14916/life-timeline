root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{py,pyi}]
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,yml,yaml,md,kt,kts,xml,properties}]
indent_size = 2

[*.{kt,kts}]
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
