* text=auto eol=lf

# Source and configuration files are normalized to LF.
*.py text eol=lf
*.pyi text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.gradle text eol=lf
*.sh text eol=lf

# Windows scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must not be line-ending normalized.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
